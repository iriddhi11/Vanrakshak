# Base URL of the backend API.
# Leave as /api in development (Vite proxies it to the backend, see vite.config.js).
# In production set the full URL, e.g. https://portal.example.gov.in/api
VITE_API_BASE_URL=/api

# Backend target used ONLY by the Vite dev-server proxy
VITE_DEV_PROXY_TARGET=http://localhost:5000
